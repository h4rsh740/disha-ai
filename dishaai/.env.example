# ============================================================
# DishaAI — Environment Variables (PPT Platform Stack)
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- 1. Authentication: Firebase ----
# Get from: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- 2. Primary AI: Google Gemini ----
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- 3. Backup AI / Gateway: OpenRouter ----
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_PRIMARY_PROVIDER=gemini

# ---- 4. Database: Supabase (PostgreSQL + pgvector) ----
# Get free project from: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL connection string (for running db/schema.sql)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- 5. Application URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- 6. Open Government Data (data.gov.in) ----
# Get from: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
