# ============================================================
# DishaAI — Environment Variables (PPT Platform Stack)
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- 1. Authentication: Clerk ----
# Get from: https://clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ---- 2. Primary AI: Google Gemini ----
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- 3. Backup AI / Gateway: OpenRouter ----
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_PRIMARY_PROVIDER=gemini

# ---- 4. Database: Supabase (PostgreSQL + pgvector) ----
# Get free project from: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct PostgreSQL connection string (for running db/schema.sql)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---- 5. Application URL ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
